<%# Vista provisoria: el diseño final llega en la etapa de estilos. %>
<%= tag.div(flash[:alert], class: "alert alert-danger") if flash[:alert] %>
<%= tag.div(flash[:notice], class: "alert alert-success") if flash[:notice] %>

<h1>Iniciar sesión</h1>

<%= form_with url: session_path do |form| %>
  <%= form.label :email_address, "Email" %>
  <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %><br>
  <%= form.label :password, "Contraseña" %>
  <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %><br>
  <%= form.submit "Ingresar" %>
<% end %>
